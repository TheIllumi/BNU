{
  "meta": {
    "name": "ClassSync Moon Crystal Theme",
    "version": "1.0.0",
    "description": "Modern UI theme based on Moon Crystal palette with 2024-2025 design trends"
  },
  "colors": {
    "primary": {
      "50": "#fef7f5",
      "100": "#ffe2db",
      "200": "#f8c4b7",
      "300": "#d9a7c6",
      "400": "#8d89c7",
      "500": "#755f9c",
      "600": "#5d4a7a",
      "700": "#4a3a61",
      "800": "#3a2d4b",
      "900": "#2d1f3a"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#fafafa",
      "100": "#f5f5f5",
      "200": "#e5e5e5",
      "300": "#d4d4d4",
      "400": "#a3a3a3",
      "500": "#737373",
      "600": "#525252",
      "700": "#404040",
      "800": "#262626",
      "900": "#171717",
      "950": "#0a0a0a"
    },
    "semantic": {
      "success": "#059669",
      "warning": "#d97706",
      "error": "#dc2626",
      "info": "#2563eb"
    }
  },
  "themes": {
    "light": {
      "background": {
        "primary": "#ffffff",
        "secondary": "#fafafa",
        "tertiary": "#f5f5f5",
        "elevated": "#ffffff",
        "overlay": "rgba(0, 0, 0, 0.5)"
      },
      "surface": {
        "primary": "#ffffff",
        "secondary": "#f8f9fa",
        "tertiary": "#e9ecef",
        "interactive": "#ffe2db",
        "hover": "#f8c4b7",
        "pressed": "#d9a7c6",
        "disabled": "#f5f5f5"
      },
      "text": {
        "primary": "#171717",
        "secondary": "#525252",
        "tertiary": "#737373",
        "disabled": "#a3a3a3",
        "inverse": "#ffffff",
        "link": "#755f9c",
        "accent": "#8d89c7"
      },
      "border": {
        "default": "#e5e5e5",
        "subtle": "#f5f5f5",
        "strong": "#d4d4d4",
        "focus": "#8d89c7",
        "error": "#dc2626",
        "success": "#059669"
      }
    },
    "dark": {
      "background": {
        "primary": "#0f0f0f",
        "secondary": "#1a1a1a",
        "tertiary": "#262626",
        "elevated": "#1f1f1f",
        "overlay": "rgba(0, 0, 0, 0.8)"
      },
      "surface": {
        "primary": "#171717",
        "secondary": "#262626",
        "tertiary": "#404040",
        "interactive": "#2d1f3a",
        "hover": "#3a2d4b",
        "pressed": "#4a3a61",
        "disabled": "#262626"
      },
      "text": {
        "primary": "#fafafa",
        "secondary": "#d4d4d4",
        "tertiary": "#a3a3a3",
        "disabled": "#525252",
        "inverse": "#171717",
        "link": "#d9a7c6",
        "accent": "#ffe2db"
      },
      "border": {
        "default": "#404040",
        "subtle": "#262626",
        "strong": "#525252",
        "focus": "#d9a7c6",
        "error": "#ef4444",
        "success": "#22c55e"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "monospace": "'JetBrains Mono', 'SF Mono', Monaco, Consolas, monospace"
    },
    "fontSize": {
      "xs": 12,
      "sm": 13,
      "base": 14,
      "lg": 16,
      "xl": 18,
      "2xl": 20,
      "3xl": 24,
      "4xl": 32
    },
    "fontWeight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96
  },
  "borderRadius": {
    "none": 0,
    "sm": 4,
    "base": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
  },
  "animation": {
    "duration": {
      "fast": 150,
      "normal": 250,
      "slow": 350
    },
    "easing": {
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "#8d89c7",
        "backgroundHover": "#755f9c",
        "backgroundPressed": "#5d4a7a",
        "text": "#ffffff",
        "border": "transparent"
      },
      "secondary": {
        "background": "transparent",
        "backgroundHover": "#ffe2db",
        "backgroundPressed": "#f8c4b7",
        "text": "#755f9c",
        "border": "#d9a7c6"
      },
      "ghost": {
        "background": "transparent",
        "backgroundHover": "#ffe2db",
        "backgroundPressed": "#f8c4b7",
        "text": "#8d89c7",
        "border": "transparent"
      }
    },
    "input": {
      "background": "#ffffff",
      "backgroundFocus": "#ffffff",
      "border": "#e5e5e5",
      "borderFocus": "#8d89c7",
      "borderError": "#dc2626",
      "text": "#171717",
      "placeholder": "#a3a3a3"
    },
    "table": {
      "headerBackground": "#fafafa",
      "headerText": "#171717",
      "rowBackground": "#ffffff",
      "rowBackgroundHover": "#ffe2db",
      "rowBackgroundSelected": "#f8c4b7",
      "border": "#e5e5e5",
      "text": "#171717"
    },
    "card": {
      "background": "#ffffff",
      "backgroundHover": "#fafafa",
      "border": "#e5e5e5",
      "borderHover": "#d9a7c6",
      "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
    },
    "sidebar": {
      "background": "#fafafa",
      "border": "#e5e5e5",
      "itemBackground": "transparent",
      "itemBackgroundHover": "#ffe2db",
      "itemBackgroundActive": "#d9a7c6",
      "itemText": "#525252",
      "itemTextActive": "#755f9c"
    }
  }
}